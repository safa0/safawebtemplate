#!/bin/bash

# ============================================
# Claude Code Web Design Setup Script
# ============================================
# This script installs and configures:
# - MCP servers for web design tools
# - Custom skills for frontend development
# - Specialized subagents
# - Useful slash commands
# - Automated hooks
# ============================================

set -e  # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
print_section() {
    echo -e "\n${BLUE}========================================${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}========================================${NC}\n"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

print_error() {
    echo -e "${RED}✗ $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

# Check if Claude Code is installed
check_claude_installed() {
    if ! command -v claude &> /dev/null; then
        print_error "Claude Code is not installed or not in PATH"
        echo "Please install Claude Code first: https://claude.ai/download"
        exit 1
    fi
    print_success "Claude Code is installed"
}

# Create directory structure
setup_directories() {
    print_section "Creating Directory Structure"
    
    # Skills directories
    mkdir -p ~/.claude/skills/user/frontend-patterns
    mkdir -p ~/.claude/skills/user/design-system
    mkdir -p ~/.claude/skills/user/web-performance
    print_success "Created skills directories"
    
    # Agents directory
    mkdir -p ~/.claude/agents
    print_success "Created agents directory"
    
    # Commands directory
    mkdir -p ~/.claude/commands/web
    print_success "Created commands directory"
    
    # Hooks directory
    mkdir -p ~/.claude/hooks/web
    print_success "Created hooks directory"
}

# Install MCP Servers
install_mcp_servers() {
    print_section "Installing MCP Servers"
    
    print_info "Installing Figma MCP (design to code)..."
    claude mcp add --transport http figma-remote-mcp https://mcp.figma.com/mcp 2>&1 || print_warning "Figma MCP might already be installed"
    
    print_info "Installing GitHub MCP (version control)..."
    claude mcp add --transport sse github https://api.github.com/mcp 2>&1 || print_warning "GitHub MCP might already be installed"
    
    print_info "Installing Canva MCP (design assets)..."
    claude mcp add --transport http canva https://mcp.canva.com/mcp 2>&1 || print_warning "Canva MCP might already be installed"
    
    print_info "Installing Cloudinary MCP (image optimization)..."
    claude mcp add --transport http cloudinary https://mcp.cloudinary.com/mcp 2>&1 || print_warning "Cloudinary MCP might already be installed"
    
    print_success "MCP servers installation complete"
}

