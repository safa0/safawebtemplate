# Create Hooks
create_hooks() {
    print_section "Creating Automated Hooks"
    
    # Format code hook
    cat > ~/.claude/hooks/web/format_code.sh << 'HOOK_EOF'
#!/bin/bash
FILE=$(echo "$CLAUDE_TOOL_INPUT" | jq -r '.file_path' 2>/dev/null)

if [[ -n "$FILE" ]]; then
  case "$FILE" in
    *.tsx|*.ts|*.jsx|*.js|*.css)
      if command -v npx &> /dev/null && [ -f "package.json" ]; then
        npx prettier --write "$FILE" 2>/dev/null || true
        echo "✓ Formatted $FILE"
      fi
      ;;
  esac
fi
exit 0
HOOK_EOF
    chmod +x ~/.claude/hooks/web/format_code.sh
    print_success "Created format_code hook"
    
    # Accessibility check hook
    cat > ~/.claude/hooks/web/check_accessibility.sh << 'HOOK_EOF'
#!/bin/bash
FILE=$(echo "$CLAUDE_TOOL_INPUT" | jq -r '.file_path' 2>/dev/null)

if [[ "$FILE" =~ \.(tsx|jsx)$ ]]; then
  ISSUES=()
  
  if grep -q 'onClick=' "$FILE" && grep -q '<div' "$FILE"; then
    if ! grep -q 'role=' "$FILE"; then
      ISSUES+=("⚠️  onClick on div without role")
    fi
  fi
  
  if grep -q '<img' "$FILE" && ! grep -q 'alt=' "$FILE"; then
    ISSUES+=("⚠️  img without alt")
  fi
  
  if grep -q '<button' "$FILE" && ! grep -q 'type=' "$FILE"; then
    ISSUES+=("⚠️  button without type")
  fi
  
  if [ ${#ISSUES[@]} -gt 0 ]; then
    echo "Accessibility warnings in $FILE:"
    printf '%s\n' "${ISSUES[@]}"
    echo "Run /web:design-review for full audit"
  fi
fi
exit 0
HOOK_EOF
    chmod +x ~/.claude/hooks/web/check_accessibility.sh
    print_success "Created check_accessibility hook"
    
    # Create settings.json
    cat > ~/.claude/settings.json << 'SETTINGS_EOF'
{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
